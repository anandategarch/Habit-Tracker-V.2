# Server-only values. Never use NEXT_PUBLIC_ for these secrets.
TURSO_DATABASE_URL=libsql://habit-tracker-v2-anandategarch.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=

# Protects the single-owner workspace when Turso is enabled.
# RUTINA_APP_PASSWORD: use a unique password (at least 12 characters).
RUTINA_APP_PASSWORD=

# Generate a random value of at least 32 characters.
# Example: openssl rand -base64 32
RUTINA_SESSION_SECRET=
